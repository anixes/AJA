# ══════════════════════════════════════════════════════════════════════════
# AJA VPS environment template
# Copy to `.env` next to docker-compose.vps.yml and fill in real values.
# NEVER commit the filled-in .env file.
# ══════════════════════════════════════════════════════════════════════════

# ── Telegram (primary chat interface) ──────────────────────────────────────
# Bot token from @BotFather. Required for `aja serve` on a VPS.
TELEGRAM_BOT_TOKEN=

# MANDATORY on any internet-facing host. Without an allowlist, the gateway
# FAILS SAFE and DENIES every remote user. Put YOUR numeric Telegram user id
# here (get it from @userinfobot). Comma-separate multiple ids.
TELEGRAM_ALLOWED_USER_IDS=

# ── LLM provider (Copilot gateway) ────────────────────────────────────────
# GitHub Copilot token (gh CLI login token or device-flow copy).
COPILOT_GITHUB_TOKEN=

# ── Fleet / baton transfer security ───────────────────────────────────────
# Shared HMAC secret for baton handover between VPS and home GPU worker.
# MUST match on both hosts. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AJA_BATON_SECRET=

# ── Embeddings (slim VPS profile — ONNX CPU, no torch) ────────────────────
AJA_EMBEDDING_BACKEND=onnx

# ── Timeouts & worker behavior ────────────────────────────────────────────
# Scheduled research missions can be long; give them room.
AJA_JOB_TIMEOUT_S=600
# Worker per-task timeout.
AJA_WORKER_TIMEOUT_S=600
# Do NOT run repo test suites inside read-only worker missions on a small VPS.
AJA_WORKER_RUN_TESTS=0

# ── Google Calendar (optional) ────────────────────────────────────────────
# Only if you want briefings/calendar sync. See docs/operator/CALENDAR.md,
# then run `docker compose ... exec aja aja calendar connect` once.
GOOGLE_CALENDAR_CLIENT_SECRET=
