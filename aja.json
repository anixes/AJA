{
    "project_name": "AJA",
    "territories": [
        {
            "path": "apps/cli-ts",
            "health_cmd": "node dist/cli.js",
            "auto_heal": true
        },
        {
            "path": "libs/aja-core",
            "health_cmd": "python -m aja status",
            "auto_heal": false
        }
    ],
    "swarm_settings": {
        "offline_mode": false,
        "max_agents": 5,
        "check_interval": 30,
        "models": {
            "planner": "copilot",
            "worker": "copilot",
            "critic": "copilot"
        },
        "operating_mode": "online",
        "allow_out_of_bounds_paths": true
    },
    "mcp_servers": [
        {
            "server_id": "sqlite",
            "transport": "stdio",
            "enabled": true,
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sqlite"
            ]
        },
        {
            "server_id": "postgres",
            "transport": "stdio",
            "enabled": true,
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-postgres"
            ]
        },
        {
            "server_id": "memory",
            "transport": "stdio",
            "enabled": true,
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ]
        },
        {
            "server_id": "gdrive",
            "transport": "stdio",
            "enabled": true,
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-gdrive"
            ]
        },
        {
            "server_id": "github",
            "transport": "stdio",
            "enabled": true,
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ]
        }
    ]
}